# Copy to .env.local for local use, and add the same two values in
# Vercel > Project > Settings > Environment Variables.
# Leave both empty locally to keep using the JSON files in /data.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=
# Supabase > Project Settings > API > anon / publishable key (needs supabase/anon_access.sql, demo only)
SUPABASE_ANON_KEY=
# Production instead: the service_role key (SECRET, server only, never NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign the login cookie
AUTH_SECRET=

# VoiceOfVillage (voiceofvillage.com/developers) key, sent as "Authorization: Bearer vov_...". Server only.
# The Lead form uses it to fill Village from the captured live location (works without a key at a lower limit).
VILLAGE_API_KEY=
# Optional: Google Maps Geocoding key (server only). With it the village is named exactly as on Google Maps;
# without it OpenStreetMap is used.
GOOGLE_MAPS_API_KEY=
