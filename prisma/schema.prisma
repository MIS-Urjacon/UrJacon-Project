generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

enum PageStatus {
  pending
  done
  hold
}

// ======================================================== users and masters

model User {
  id           String   @id // U-0001
  username     String   @unique
  name         String   @default("")
  role         Role     @default(user)
  active       Boolean  @default(true)
  pages        Json? // custom page access (list of page slugs); NULL = follow the role
  passwordHash String   @map("password_hash") // salted scrypt, never plain text
  createdAt    DateTime @default(now()) @map("created_at")

  defaultPages PageDefaultAssignee[]
  assignments  Assignment[]

  @@map("users")
}

model Master {
  id        Int    @id @default(autoincrement())
  type      String
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  @@unique([type, value])
  @@map("masters")
}

// Settings > Assignees: who gets all new work that arrives on a page.
model PageDefaultAssignee {
  pageSlug String @map("page_slug")
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pageSlug, userId])
  @@map("page_default_assignees")
}

// ======================================================== lead management

// Leads page
model Lead {
  id          String    @id // L-0001
  timestamp   DateTime  @default(now()) // created
  plannedDate DateTime? @map("planned_date") // first follow-up due
  actualDate  DateTime? @map("actual_date") // first contact done
  status      String    @default("open") // open | lost | converted | quotation
  leadStage   String    @default("new") @map("lead_stage")
  lostReason  String    @default("") @map("lost_reason")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  customerName       String    @map("customer_name")
  mobile             String
  email              String    @default("")
  address            String    @default("")
  village            String    @default("")
  state              String    @default("") // master: state
  latitude           Decimal?  @db.Decimal(10, 7)
  longitude          Decimal?  @db.Decimal(10, 7)
  locationAccuracy   Decimal?  @map("location_accuracy") @db.Decimal(10, 2)
  locationCapturedAt DateTime? @map("location_captured_at")

  bpScNumber        String  @default("") @map("bp_sc_number")
  source            String  @default("")
  agent             String  @default("")
  monthlyBill       Decimal @default(0) @map("monthly_bill") @db.Decimal(12, 2)
  kwWanted          Decimal @default(0) @map("kw_wanted") @db.Decimal(8, 2)
  productInterested String  @default("") @map("product_interested") // Hybrid / On-grid
  pricing           String  @default("") // CL / ML
  paymentMode       String  @default("") @map("payment_mode") // master: paymentMode
  temperature       String  @default("Follow up Required")
  outcome           String  @default("") // latest Call Tracker response
  remark            String  @default("")
  commission        Decimal @default(0) @db.Decimal(12, 2)
  dealAmount        Decimal @default(0) @map("deal_amount") @db.Decimal(14, 2)
  branch            String  @default("") // masters
  dealer            String  @default("")
  liaisoning        String  @default("")
  route             String  @default("")
  productCode       String  @default("") @map("product_code")
  brand             String  @default("")
  // handover packet ticks
  docAadhaar        Boolean @default(false) @map("doc_aadhaar")
  docPan            Boolean @default(false) @map("doc_pan")
  docPassbook       Boolean @default(false) @map("doc_passbook")
  docBill           Boolean @default(false) @map("doc_bill")
  docTerracePhoto   Boolean @default(false) @map("doc_terrace_photo")
  ownershipDocument Json?   @map("ownership_document")

  calls       CallTracker[]
  quotations  Quotation[]
  case        Case?
  assignments Assignment[]

  @@index([mobile])
  @@index([status])
  @@index([bpScNumber])
  @@map("leads")
}

// Call Tracker page: one row per call / visit / WhatsApp.
// planned_date = the follow-up that was due, actual_date = when it was really done.
model CallTracker {
  id           Int       @id @default(autoincrement())
  leadId       String    @map("lead_id")
  timestamp    DateTime  @default(now())
  plannedDate  DateTime? @map("planned_date")
  actualDate   DateTime? @map("actual_date")
  contactType  String    @default("") @map("contact_type") // Call / Visit / WhatsApp
  response     String    @default("") // Call back later / Visit required / Document given / Not interested
  nextFollowUp DateTime? @map("next_follow_up")
  visitBy      String    @default("") @map("visit_by")
  remark       String    @default("")
  byUser       String    @default("") @map("by_user")
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("call_tracker")
}

// Quotation page: one row per version (revision 0, R1, R2 ...).
model Quotation {
  id             Int       @id @default(autoincrement())
  leadId         String    @map("lead_id")
  revision       Int       @default(0)
  timestamp      DateTime  @default(now()) // created
  plannedDate    DateTime? @map("planned_date")
  actualDate     DateTime? @map("actual_date") // sent
  status         String    @default("draft") // draft | sent
  reference      String    @default("") // URJ/Q/26-27/0107
  number         String    @default("") // reference + /R1
  revisionReason String    @default("") @map("revision_reason")
  sentBy         String?   @map("sent_by")
  channel        String    @default("")
  entity         String    @default("")
  systemType     String    @default("") @map("system_type")
  dcrType        String    @default("") @map("dcr_type")
  gridType       String    @default("") @map("grid_type")
  kwWanted       Decimal   @default(0) @map("kw_wanted") @db.Decimal(8, 2)
  price          Decimal   @default(0) @db.Decimal(14, 2)
  centralSubsidy Decimal   @default(0) @map("central_subsidy") @db.Decimal(14, 2)
  stateSubsidy   Decimal   @default(0) @map("state_subsidy") @db.Decimal(14, 2)
  panelCount     Int       @default(0) @map("panel_count")
  panelWp        Int       @default(0) @map("panel_wp")
  panelBrand     String    @default("") @map("panel_brand")
  inverter       String    @default("")
  meter          String    @default("")
  included       String    @default("")
  preparedBy     String    @default("") @map("prepared_by")
  paymentMode    String    @default("") @map("payment_mode")
  productCode    String    @default("") @map("product_code")
  validityDays   Int       @default(15) @map("validity_days")
  notes          String    @default("")
  terms          String    @default("")
  files          Json? // supporting files
  proposal       Json? // UrjaCon Proposal Studio answers + map / design pictures
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, revision])
  @@map("quotations")
}

// ======================================================== case

// A confirmed lead (Call Tracker "Document given"). stage = the page the case is on now.
model Case {
  id              String   @id // C-0001
  leadId          String?  @unique @map("lead_id")
  timestamp       DateTime @default(now()) // created
  updatedAt       DateTime @updatedAt @map("updated_at")
  workflowVersion Int      @default(3) @map("workflow_version")
  stage           String   @default("documentReceive") // step key, or "done"

  bpScNumber   String   @unique @map("bp_sc_number")
  customerName String   @map("customer_name")
  mobile       String   @default("")
  email        String   @default("")
  address      String   @default("")
  village      String   @default("")
  state        String   @default("") // master: state
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  leadSource   String   @default("") @map("lead_source")
  fieldStaff   String   @default("") @map("field_staff")
  commission   Decimal  @default(0) @db.Decimal(12, 2)

  // price and system, set at Document Receive and read by every later step
  dealAmount           Decimal @default(0) @map("deal_amount") @db.Decimal(14, 2)
  kwWanted             Decimal @default(0) @map("kw_wanted") @db.Decimal(8, 2)
  centralSubsidy       Decimal @default(0) @map("central_subsidy") @db.Decimal(14, 2)
  stateSubsidy         Decimal @default(0) @map("state_subsidy") @db.Decimal(14, 2)
  preferredPaymentMode String  @default("") @map("preferred_payment_mode") // master: paymentMode
  branch               String  @default("")
  dealer               String  @default("")
  liaisoning           String  @default("")
  route                String  @default("")
  productCode          String  @default("") @map("product_code")
  brand                String  @default("")
  ownershipDocument    Json?   @map("ownership_document")

  lead Lead? @relation(fields: [leadId], references: [id])

  issues                   Issue[]
  paymentSends             PaymentDetailsSent[]
  assignments              Assignment[]
  documentReceive          DocumentReceive?
  documentVerification     DocumentVerification?
  loginPmsg                LoginPmsg?
  nameCorrection           NameCorrection?
  ownerChange              OwnerChange?
  agreement                Agreement?
  siteSurvey               SiteSurvey?
  paymentWorkStart         PaymentWorkStart?
  jansamarth               Jansamarth?
  bankFileReady            BankFileReady?
  fileSubmission           FileSubmission?
  loanIssueResolution      LoanIssueResolution?
  firstInstallment         FirstInstallment?
  receiveDp                ReceiveDp?
  cashAskPayment           CashAskPayment?
  cashPaymentReceived      CashPaymentReceived?
  cashApproval             CashApproval?
  subsidyChequeReady       SubsidyChequeReady?
  cashReceipt              CashReceipt?
  dispatch                 Dispatch?
  cashDispatch             CashDispatch?
  assignInstaller          AssignInstaller?
  installationComplete     InstallationComplete?
  billDcr                  BillDcr?
  portalInstallation       PortalInstallation?
  inspectionFile           InspectionFile?
  meterInstallation        MeterInstallation?
  jeInspection             JeInspection?
  generationWifi           GenerationWifi?
  portalInspectionApproval PortalInspectionApproval?
  tariffCodeCheck          TariffCodeCheck?
  finalBankFile            FinalBankFile?
  finalBankPayment         FinalBankPayment?
  subsidyRedeem            SubsidyRedeem?
  subsidyDisbursal         SubsidyDisbursal?
  chequeDeposit            ChequeDeposit?
  balanceClearance         BalanceClearance?
  warranty                 Warranty?

  @@index([stage])
  @@map("cases")
}

// "Send payment details to customer" log (Ask 90% Payment page)
model PaymentDetailsSent {
  id      Int      @id @default(autoincrement())
  caseId  String   @map("case_id")
  sentAt  DateTime @default(now()) @map("sent_at")
  sentBy  String   @default("") @map("sent_by")
  channel String   @default("whatsapp")
  message String   @default("")
  case    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("payment_details_sent")
}

// Report Issue: sends the case back to Document Receive until it is resolved.
model Issue {
  id         Int       @id @default(autoincrement())
  caseId     String    @map("case_id")
  fromStep   String    @map("from_step") // step key the issue was reported from
  issueType  String    @map("issue_type")
  details    String    @default("")
  status     String    @default("open") // open | resolved
  reportedBy String    @default("") @map("reported_by")
  reportedAt DateTime  @default(now()) @map("reported_at")
  resolvedAt DateTime? @map("resolved_at")
  files      Json?
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@map("issues")
}

// Assign Work page + the bell: one row per assignee per assignment (and per take-back).
model Assignment {
  id             String    @id @default(uuid())
  recordType     String    @map("record_type") // lead | case
  leadId         String?   @map("lead_id")
  caseId         String?   @map("case_id")
  page           String    @default("") // page slug
  pageLabel      String    @default("") @map("page_label")
  action         String    @default("assigned") // assigned | removed
  kind           String    @default("temporary") // temporary (Assign button) | permanent (Settings)
  active         Boolean   @default(true) // false once the work moved on or was taken back
  assignedToId   String?   @map("assigned_to_id")
  assignedToName String    @default("") @map("assigned_to_name")
  assignedByName String    @default("") @map("assigned_by_name")
  assignedOn     DateTime? @map("assigned_on") @db.Date
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  seenAt         DateTime? @map("seen_at") // NULL = not read yet
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  case           Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedTo     User?     @relation(fields: [assignedToId], references: [id])

  @@index([assignedToId, seenAt])
  @@map("assignments")
}

// ======================================================== case pages (one table per page, one row per case)
// Common columns: timestamp, planned_date, actual_date, status, hold_code, remark, submitted_by.
// Page fields below are NULL until the page is submitted.

// Document Receive: price, system, the 4 received documents, correction (step key: documentReceive)
model DocumentReceive {
  id                 Int        @id @default(autoincrement())
  caseId             String     @unique @map("case_id")
  timestamp          DateTime   @default(now())
  plannedDate        DateTime?  @map("planned_date")
  actualDate         DateTime?  @map("actual_date")
  status             PageStatus @default(pending)
  holdCode           String?    @map("hold_code") // H01..H22
  remark             String?
  submittedBy        String?    @map("submitted_by")
  receivedThrough    String?    @map("received_through")
  receivedDate       DateTime?  @map("received_date") @db.Date
  systemType         String?    @map("system_type")
  paymentMode        String?    @map("payment_mode")
  systemSizeKw       Decimal?   @map("system_size_kw") @db.Decimal(14, 2)
  systemPrice        Decimal?   @map("system_price") @db.Decimal(14, 2)
  centralSubsidy     Decimal?   @map("central_subsidy") @db.Decimal(14, 2)
  stateSubsidy       Decimal?   @map("state_subsidy") @db.Decimal(14, 2)
  productCode        String?    @map("product_code")
  panel              String?
  brand              String?
  aadhaarName        String?    @map("aadhaar_name")
  aadhaarMatched     Boolean?   @map("aadhaar_matched")
  aadhaarStatus      String?    @map("aadhaar_status")
  aadhaarFiles       Json?      @map("aadhaar_files")
  panName            String?    @map("pan_name")
  panMatched         Boolean?   @map("pan_matched")
  panStatus          String?    @map("pan_status")
  panFiles           Json?      @map("pan_files")
  passbookName       String?    @map("passbook_name")
  passbookMatched    Boolean?   @map("passbook_matched")
  passbookStatus     String?    @map("passbook_status")
  passbookFiles      Json?      @map("passbook_files")
  billName           String?    @map("bill_name")
  billMatched        Boolean?   @map("bill_matched")
  billStatus         String?    @map("bill_status")
  billFiles          Json?      @map("bill_files")
  terracePhotoFiles  Json?      @map("terrace_photo_files")
  correctionType     String?    @map("correction_type")
  correctionReason   String?    @map("correction_reason")
  verificationResult String?    @map("verification_result")
  case               Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("document_receive")
}

// Document Verification & Name Check: each document ticked Verified (step key: nameCheck)
model DocumentVerification {
  id               Int        @id @default(autoincrement())
  caseId           String     @unique @map("case_id")
  timestamp        DateTime   @default(now())
  plannedDate      DateTime?  @map("planned_date")
  actualDate       DateTime?  @map("actual_date")
  status           PageStatus @default(pending)
  holdCode         String?    @map("hold_code") // H01..H22
  remark           String?
  submittedBy      String?    @map("submitted_by")
  aadhaarVerified  Boolean?   @map("aadhaar_verified")
  panVerified      Boolean?   @map("pan_verified")
  passbookVerified Boolean?   @map("passbook_verified")
  billVerified     Boolean?   @map("bill_verified")
  case             Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("document_verification")
}

// Login PMSG (step key: login)
model LoginPmsg {
  id            Int        @id @default(autoincrement())
  caseId        String     @unique @map("case_id")
  timestamp     DateTime   @default(now())
  plannedDate   DateTime?  @map("planned_date")
  actualDate    DateTime?  @map("actual_date")
  status        PageStatus @default(pending)
  holdCode      String?    @map("hold_code") // H01..H22
  remark        String?
  submittedBy   String?    @map("submitted_by")
  loginCheck    String?    @map("login_check")
  applicationNo String?    @map("application_no")
  route         String?
  retryDate     DateTime?  @map("retry_date") @db.Date
  case          Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("login_pmsg")
}

// Name Correction (step key: nameCorrection)
model NameCorrection {
  id              Int        @id @default(autoincrement())
  caseId          String     @unique @map("case_id")
  timestamp       DateTime   @default(now())
  plannedDate     DateTime?  @map("planned_date")
  actualDate      DateTime?  @map("actual_date")
  status          PageStatus @default(pending)
  holdCode        String?    @map("hold_code") // H01..H22
  remark          String?
  submittedBy     String?    @map("submitted_by")
  correctedName   String?    @map("corrected_name")
  correctionFiles Json?      @map("correction_files")
  case            Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("name_correction")
}

// Owner Change (step key: ownerChange)
model OwnerChange {
  id           Int        @id @default(autoincrement())
  caseId       String     @unique @map("case_id")
  timestamp    DateTime   @default(now())
  plannedDate  DateTime?  @map("planned_date")
  actualDate   DateTime?  @map("actual_date")
  status       PageStatus @default(pending)
  holdCode     String?    @map("hold_code") // H01..H22
  remark       String?
  submittedBy  String?    @map("submitted_by")
  newOwnerName String?    @map("new_owner_name")
  ownerFiles   Json?      @map("owner_files")
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("owner_change")
}

// Consumer-Vendor Agreement (step key: agreementUpload)
model Agreement {
  id             Int        @id @default(autoincrement())
  caseId         String     @unique @map("case_id")
  timestamp      DateTime   @default(now())
  plannedDate    DateTime?  @map("planned_date")
  actualDate     DateTime?  @map("actual_date")
  status         PageStatus @default(pending)
  holdCode       String?    @map("hold_code") // H01..H22
  remark         String?
  submittedBy    String?    @map("submitted_by")
  agreementDate  DateTime?  @map("agreement_date") @db.Date
  stampAmount    Decimal?   @map("stamp_amount") @db.Decimal(14, 2)
  agreementFiles Json?      @map("agreement_files")
  case           Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("agreement")
}

// Survey List (step key: siteSurvey)
model SiteSurvey {
  id                    Int        @id @default(autoincrement())
  caseId                String     @unique @map("case_id")
  timestamp             DateTime   @default(now())
  plannedDate           DateTime?  @map("planned_date")
  actualDate            DateTime?  @map("actual_date")
  status                PageStatus @default(pending)
  holdCode              String?    @map("hold_code") // H01..H22
  remark                String?
  submittedBy           String?    @map("submitted_by")
  surveyDate            DateTime?  @map("survey_date") @db.Date
  surveyorName          String?    @map("surveyor_name")
  smartMeterPresent     String?    @map("smart_meter_present")
  materialNeeded        String?    @map("material_needed")
  phaseType             String?    @map("phase_type")
  connectionCategory    String?    @map("connection_category")
  meterType             String?    @map("meter_type")
  roofType              String?    @map("roof_type")
  mountingType          String?    @map("mounting_type")
  structureSize         String?    @map("structure_size")
  roofOrientation       String?    @map("roof_orientation")
  roofCondition         String?    @map("roof_condition")
  roofAge               Decimal?   @map("roof_age") @db.Decimal(14, 2)
  usableArea            Decimal?   @map("usable_area") @db.Decimal(14, 2)
  shading               String?
  accessDetails         String?    @map("access_details")
  materialsAvailable    Json?      @map("materials_available")
  panelInverterDistance Decimal?   @map("panel_inverter_distance") @db.Decimal(14, 2)
  inverterDbDistance    Decimal?   @map("inverter_db_distance") @db.Decimal(14, 2)
  earthingDistance      Decimal?   @map("earthing_distance") @db.Decimal(14, 2)
  ventilation           String?
  wifiLan               String?    @map("wifi_lan")
  vehicleAccess         String?    @map("vehicle_access")
  ladderNeeded          String?    @map("ladder_needed")
  storageAvailable      String?    @map("storage_available")
  obstacles             String?
  installationDate      DateTime?  @map("installation_date") @db.Date
  photosTaken           Json?      @map("photos_taken")
  photoFiles            Json?      @map("photo_files")
  surveyorRemarks       String?    @map("surveyor_remarks")
  case                  Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("site_survey")
}

// Payment Work Start (step key: paymentWorkStart)
model PaymentWorkStart {
  id          Int        @id @default(autoincrement())
  caseId      String     @unique @map("case_id")
  timestamp   DateTime   @default(now())
  plannedDate DateTime?  @map("planned_date")
  actualDate  DateTime?  @map("actual_date")
  status      PageStatus @default(pending)
  holdCode    String?    @map("hold_code") // H01..H22
  remark      String?
  submittedBy String?    @map("submitted_by")
  paymentMode String?    @map("payment_mode")
  corridor    String?
  case        Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("payment_work_start")
}

// JanSamarth Application (step key: janSamarth)
model Jansamarth {
  id            Int        @id @default(autoincrement())
  caseId        String     @unique @map("case_id")
  timestamp     DateTime   @default(now())
  plannedDate   DateTime?  @map("planned_date")
  actualDate    DateTime?  @map("actual_date")
  status        PageStatus @default(pending)
  holdCode      String?    @map("hold_code") // H01..H22
  remark        String?
  submittedBy   String?    @map("submitted_by")
  approvalDate  DateTime?  @map("approval_date") @db.Date
  bankFileFiles Json?      @map("bank_file_files")
  case          Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("jansamarth")
}

// Bank File Ready (step key: bankFileReady)
model BankFileReady {
  id                Int        @id @default(autoincrement())
  caseId            String     @unique @map("case_id")
  timestamp         DateTime   @default(now())
  plannedDate       DateTime?  @map("planned_date")
  actualDate        DateTime?  @map("actual_date")
  status            PageStatus @default(pending)
  holdCode          String?    @map("hold_code") // H01..H22
  remark            String?
  submittedBy       String?    @map("submitted_by")
  bank              String?
  bankBranch        String?    @map("bank_branch")
  bankQuotation     Decimal?   @map("bank_quotation") @db.Decimal(14, 2)
  responsiblePerson String?    @map("responsible_person")
  case              Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("bank_file_ready")
}

// File Submission in Bank (step key: fileSubmission)
model FileSubmission {
  id              Int        @id @default(autoincrement())
  caseId          String     @unique @map("case_id")
  timestamp       DateTime   @default(now())
  plannedDate     DateTime?  @map("planned_date")
  actualDate      DateTime?  @map("actual_date")
  status          PageStatus @default(pending)
  holdCode        String?    @map("hold_code") // H01..H22
  remark          String?
  submittedBy     String?    @map("submitted_by")
  submissionFiles Json?      @map("submission_files")
  case            Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, plannedDate])
  @@map("file_submission")
}

// PHS & Loan Decision (step key: loanIssue)
model LoanIssueResolution {
